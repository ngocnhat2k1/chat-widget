# ── Database (PostgreSQL via docker-compose) ──────────────────────────────
DATABASE_URL="postgresql://chatuser:chatpass123@localhost:5432/chat_widget"

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ── App ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# CORS for the admin HTTP API (fixed allow-list). Widget endpoints
# (/api/widget/*, /api/uploads/*) reflect any origin via WidgetCorsMiddleware.
ADMIN_CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Legacy fallback if ADMIN_CORS_ORIGINS is unset:
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ── Image uploads — Cloudinary (Phase 2.5) ────────────────────────────────
# Unset → POST /api/uploads/image returns 503 (feature disabled).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Offline email notifications — Resend (Phase 2.6) ──────────────────────
# Unset → offline emails are skipped (no-op).
RESEND_API_KEY=
EMAIL_FROM="Chat Widget <noreply@yourapp.com>"

# ── Error tracking — Sentry (Phase 2.8) ───────────────────────────────────
# Unset → Sentry init is a no-op.
SENTRY_DSN=
