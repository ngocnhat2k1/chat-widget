# ── Backend API ───────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── Widget CDN URL (used in embed code snippets) ──────────────────────────────
VITE_WIDGET_URL=http://localhost:5173/chat-widget.iife.js

# ── Error tracking — Sentry (Phase 2.8) ──────────────────────────────────────
# Unset → Sentry init is a no-op.
VITE_SENTRY_DSN=

# ── Landing page analytics — Plausible (Phase 4) ─────────────────────────────
# Set to your site's domain as registered on plausible.io, e.g. "app.yourapp.com".
# Unset → analytics script is not injected (no-op).
VITE_PLAUSIBLE_DOMAIN=
